# Copy to .env and fill in. .env is gitignored — secrets never enter the repo.

# App database (dev default: local socket cluster started by scripts/db.sh)
DATABASE_URL=postgresql://postgres@localhost/scorp?host=/tmp/scorp-pg
# Maintenance connection used by migrate/seed/tests to create databases
DATABASE_ADMIN_URL=postgresql://postgres@localhost/postgres?host=/tmp/scorp-pg

# 32-byte base64 key for at-rest encryption (SSN, Plaid tokens): openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Session cookie signing key: openssl rand -base64 32
SESSION_SECRET=

# Owner login: set with `npm run set-password` (writes the scrypt hash here)
OWNER_PASSWORD_HASH=

# Chromium binary for PDF generation (templates, later pay stubs/workpapers).
# Pre-installed in the CCR container at /opt/pw-browsers/chromium.
CHROMIUM_PATH=
